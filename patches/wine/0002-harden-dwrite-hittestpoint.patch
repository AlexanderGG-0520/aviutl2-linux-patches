 static HRESULT WINAPI dwritetextlayout_HitTestTextPosition(IDWriteTextLayout4 *iface,
         UINT32 position, BOOL is_trailinghit, FLOAT *point_x, FLOAT *point_y,
         DWRITE_HIT_TEST_METRICS *metrics);
+
+static struct layout_effective_run *layout_get_erun_for_position(
+        const struct dwrite_textlayout *layout, UINT32 position)
+{
+    struct layout_effective_run *run;
+    UINT32 start;
+
+    LIST_FOR_EACH_ENTRY(run, &layout->eruns, struct layout_effective_run, entry)
+    {
+        start = run->run->start_position + run->start;
+
+        if (start <= position && position < start + run->length)
+            return run;
+    }
+
+    return NULL;
+}
+
+static struct layout_effective_run *layout_get_nearest_erun(
+        const struct dwrite_textlayout *layout, UINT32 position, BOOL *use_end)
+{
+    struct layout_effective_run *run, *previous = NULL;
+    UINT32 start;
+
+    LIST_FOR_EACH_ENTRY(run, &layout->eruns, struct layout_effective_run, entry)
+    {
+        start = run->run->start_position + run->start;
+
+        if (start > position)
+        {
+            if (previous)
+            {
+                *use_end = TRUE;
+                return previous;
+            }
+
+            *use_end = FALSE;
+            return run;
+        }
+
+        previous = run;
+    }
+
+    if (previous)
+    {
+        *use_end = TRUE;
+        return previous;
+    }
+
+    return NULL;
+}
+
+static HRESULT layout_set_synthetic_caret(const struct dwrite_textlayout *layout,
+        struct layout_effective_run *run, UINT32 position, FLOAT offset,
+        FLOAT *point_x, FLOAT *point_y, DWRITE_HIT_TEST_METRICS *metrics)
+{
+    metrics->textPosition = position;
+    metrics->length = 0;
+    metrics->top = run->origin.y - layout->lines[run->line].metrics.baseline;
+    metrics->width = 0.0f;
+    metrics->height = layout->lines[run->line].metrics.height;
+    metrics->bidiLevel = run->run->u.regular.run.bidiLevel;
+    metrics->isText = TRUE;
+    metrics->isTrimmed = FALSE;
+
+    if (is_run_rtl(run))
+        metrics->left = run->origin.x + run->align_dx - offset;
+    else
+        metrics->left = run->origin.x + run->align_dx + offset;
+
+    *point_x = metrics->left;
+    *point_y = metrics->top;
+
+    TRACE("Using synthetic caret for text position %u at %.8e, %.8e.\n",
+            position, *point_x, *point_y);
+    return S_OK;
+}
 
