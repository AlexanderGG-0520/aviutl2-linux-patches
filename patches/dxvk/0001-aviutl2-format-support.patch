+++ b/src/d3d11/d3d11_device.cpp
@@ -26,5 +26,6 @@
 #include "../wsi/wsi_window.h"
 
+#include "../util/util_env.h"
 #include "../util/util_shared_res.h"
 
 namespace dxvk {
@@ -225,12 +226,40 @@
     
     HRESULT hr = D3D11CommonTexture::NormalizeTextureProperties(&desc);
 
+    static const bool isAviUtl2
+      = env::getExeName() == "aviutl2.exe";
+
+    const auto logAviUtl2TextureFailure = [&] (const char* stage) {
+      if (!isAviUtl2)
+        return;
+
+      Logger::warn(str::format(
+        "AviUtl2 diagnostic: CreateTexture2D failed during ", stage,
+        "\n  Width: ", desc.Width,
+        "\n  Height: ", desc.Height,
+        "\n  MipLevels: ", desc.MipLevels,
+        "\n  ArraySize: ", desc.ArraySize,
+        "\n  Format: ", static_cast<uint32_t>(desc.Format),
+        "\n  SampleCount: ", desc.SampleDesc.Count,
+        "\n  SampleQuality: ", desc.SampleDesc.Quality,
+        "\n  Usage: ", static_cast<uint32_t>(desc.Usage),
+        "\n  BindFlags: ", desc.BindFlags,
+        "\n  CPUAccessFlags: ", desc.CPUAccessFlags,
+        "\n  MiscFlags: ", desc.MiscFlags,
+        "\n  TextureLayout: ", static_cast<uint32_t>(desc.TextureLayout),
+        "\n  InitialData: ", pInitialData != nullptr));
+    };
+
     if ((desc.MiscFlags & D3D11_RESOURCE_MISC_TILED)
