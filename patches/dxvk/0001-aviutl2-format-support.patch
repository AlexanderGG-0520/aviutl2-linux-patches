     }
@@ -1547,5 +1577,22 @@
   HRESULT STDMETHODCALLTYPE D3D11Device::CheckFormatSupport(
           DXGI_FORMAT Format,
           UINT*       pFormatSupport) {
-    return GetFormatSupportFlags(Format, pFormatSupport, nullptr);
+    const HRESULT result = GetFormatSupportFlags(
+      Format, pFormatSupport, nullptr);
+
+    static const bool isAviUtl2
+      = env::getExeName() == "aviutl2.exe";
+
+    if (FAILED(result)
+     && pFormatSupport != nullptr
+     && isAviUtl2
+     && Format == DXGI_FORMAT_G8R8_G8B8_UNORM) {
+      *pFormatSupport = 0;
+      Logger::warn("AviUtl2 compatibility: unsupported "
+        "DXGI_FORMAT_G8R8_G8B8_UNORM query; "
+        "returning S_OK with zero flags");
+      return S_OK;
+    }
+
+    return result;
   }
