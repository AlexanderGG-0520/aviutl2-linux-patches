+      logAviUtl2TextureFailure("tiled-resource validation");
       return E_INVALIDARG;
+    }
 
-    if (FAILED(hr))
+    if (FAILED(hr)) {
+      logAviUtl2TextureFailure("property normalization");
       return hr;
+    }
     
     if (!ppTexture2D)
       return S_FALSE;
@@ -241,6 +270,7 @@
       *ppTexture2D = texture.ref();
