diff --git a/src/d3d11/d3d11_device.cpp b/src/d3d11/d3d11_device.cpp
--- a/src/d3d11/d3d11_device.cpp
+++ b/src/d3d11/d3d11_device.cpp
@@ -30,6 +30,7 @@
 
 #include "../wsi/wsi_window.h"
 
+#include "../util/util_env.h"
 #include "../util/util_shared_res.h"
 
 namespace dxvk {
@@ -1976,12 +1977,24 @@
 
 
   HRESULT D3D11Device::GetFormatSupportFlags(DXGI_FORMAT Format, UINT* pFlags1, UINT* pFlags2) const {
+    static const bool isAviUtl2 = env::getExeName() == "aviutl2.exe";
     const DXGI_VK_FORMAT_INFO fmtMapping = LookupFormat(Format, DXGI_VK_FORMAT_MODE_ANY);
 
     // Reset output flags preemptively
     if (pFlags1 != nullptr) *pFlags1 = 0;
     if (pFlags2 != nullptr) *pFlags2 = 0;
 
+    // AviUtl2 probes this valid packed 4:2:2 format during startup.
+    // Limit the workaround to AviUtl2 and only when DXVK has no
+    // Vulkan mapping, preserving normal format reporting elsewhere.
+    if (isAviUtl2
+     && Format == DXGI_FORMAT_G8R8_G8B8_UNORM
+     && fmtMapping.Format == VK_FORMAT_UNDEFINED) {
+      Logger::warn("AviUtl2 compatibility: treating unsupported "
+        "DXGI_FORMAT_G8R8_G8B8_UNORM query as successful");
+      return S_OK;
+    }
+
     // Unsupported or invalid format
     if (Format && fmtMapping.Format == VK_FORMAT_UNDEFINED)
       return E_FAIL;
